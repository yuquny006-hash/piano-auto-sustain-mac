<skin>
	<!--
		Windows: Resources must be included as RC_DATA (not BITMAP!),
		the 'path' attribute is an integer resource identifier.
	-->
	<resources>
		<bitmap name="bmEchoBackground" path="1001"/>
	</resources>

	<template name="editor" background="bmEchoBackground">
		<valuebox name="quantize" 		tip="Echo Quantize" 	size="88,70,60,18"		style="led|horiz-valuebar"/>
		<valuebox name="length"			tip="Length" 			size="88,31, 60,18"		style="led|horiz-valuebar"/>
		<valuebox name="repeatRate"		tip="Repeat Rate"		size="18,70, 60,18"		style="led|horiz-valuebar|no-updown"/>
		<valuebox name="echo" 			tip="Quantize"			size="18,31,60,18"		style="led|horiz-valuebar"/>

		<valuebox name="echoDecay" 		tip="Echo Decay"		size="177,70, 60,18"	style="led|horiz-valuebar|no-updown"/>
		<valuebox name="lengthDecay" 	tip="Length Decay"		size="247,70, 60,18"	style="led|horiz-valuebar|no-updown"/>
		<valuebox name="velocityDecay" 	tip="Velocity Decay"	size="177,31,60,18"		style="led|horiz-valuebar|no-updown"/>
		<valuebox name="pitchDecay" 	tip="Pitch Decay"		size="247,31,60,18"		style="led|horiz-valuebar|no-updown"/>
		
		<!-- the preset view is created by the host application: -->
		<view name="host.PresetViewHorizontalSmallNewer" data="Preset" size="166,124,140,20"/>
	</template>
</skin>
